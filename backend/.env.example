# Copy to .env and fill in. Never commit .env.
PORT=4000

# MySQL connection string. Aiven/managed MySQL needs SSL.
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DBNAME
DB_SSL=true
# Optional: path to the provider's CA certificate (Aiven: download ca.pem from the console)
DB_SSL_CA_PATH=

# Long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h

# 64 hex chars (32 bytes). Encrypts the e-way bill provider secret at rest.
SETTINGS_KEY=

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:8080,https://your-frontend.vercel.app

# Public URL of the frontend, used in invite links
APP_URL=http://localhost:8080

# SMTP: "tls" for port 465 or "starttls" for 587. "none" only for local Mailpit.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Girder <no-reply@example.com>

# One-time first-Owner setup (npm run setup:owner). Remove the password after running it.
# Enable the first master-admin web registration with a private setup code.
# Generate: openssl rand -hex 32. Remove after registration; never expose as VITE_*.
SETUP_REGISTRATION_TOKEN=
SETUP_ORG_NAME=
SETUP_ORG_GSTIN=
SETUP_OWNER_NAME=
SETUP_OWNER_EMAIL=
SETUP_OWNER_PASSWORD=
SETUP_OWNER_MOBILE=
