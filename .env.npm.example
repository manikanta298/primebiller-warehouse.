# NPM deployment only. Save as .env.npm (excluded from Git).
# Start the MySQL server separately. This configuration never starts Docker.
WEB_HOST=127.0.0.1
WEB_PORT=8080
API_PORT=4000
FRONTEND_PORT=3000
APP_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# Create database girder first and apply backend/db/schema.sql or npm run db:migrate.
# URL-encode reserved characters in the database password.
DATABASE_URL=mysql://girder:CHANGE_THIS@127.0.0.1:3306/girder
DB_SSL=false

# Generate distinct values with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
SETTINGS_KEY=REPLACE_WITH_ANOTHER_64_HEX_CHARACTERS
JWT_EXPIRES_IN=12h

# For password recovery configure a real SMTP provider.
# Leave SMTP_HOST empty only for initial UI/API testing (email will not deliver).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Girder <no-reply@example.com>

# Only needed once during npm run setup:owner
SETUP_ORG_NAME=
SETUP_ORG_GSTIN=
SETUP_OWNER_NAME=
SETUP_OWNER_EMAIL=
SETUP_OWNER_PASSWORD=
SETUP_OWNER_MOBILE=
