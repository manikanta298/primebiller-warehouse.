{
  "name": "primebiller",
  "private": true,
  "type": "module",
  "description": "PrimeBiller warehouse: frontend/ (TanStack Start) + backend/ (Express/MySQL), orchestrated from the repo root.",
  "scripts": {
    "install:frontend": "npm --prefix frontend ci",
    "install:backend": "npm --prefix backend ci",
    "install:all": "npm run install:frontend && npm run install:backend",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "start": "node scripts/npm-start.mjs",
    "build:frontend": "npm --prefix frontend run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:all": "npm run build:frontend && npm run build:backend",
    "db:migrate": "node scripts/npm-backend-task.mjs db:migrate",
    "setup:owner": "node scripts/npm-backend-task.mjs setup:owner",
    "test:frontend": "npm --prefix frontend run test:conversion && npm --prefix frontend run test:first-admin && npm --prefix frontend run test:responsive",
    "test:ops": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:backend": "npm --prefix backend test",
    "test": "npm run test:frontend && npm run test:backend && npm run test:ops",
    "test:npm-deployment": "node --test tests/npm-deployment.test.mjs",
    "test:release-security": "node --experimental-strip-types --test tests/release-security.test.mjs",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "sync:shared": "node scripts/sync-shared.mjs",
    "verify:production-env": "node scripts/production-preflight.mjs .env",
    "audit:deployment": "node scripts/package-audit.mjs",
    "smoke:gateway": "node scripts/http-smoke.mjs",
    "smoke:authenticated": "node scripts/authenticated-smoke.mjs",
    "smoke:tenant": "node scripts/tenant-isolation-smoke.mjs",
    "smoke:workflow": "node scripts/workflow-acceptance-smoke.mjs",
    "smoke:mysql-rollback": "node scripts/mysql-rollback-smoke.mjs"
  }
}
