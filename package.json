{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "install:backend": "npm --prefix backend ci",
    "start": "node scripts/npm-start.mjs",
    "build:frontend": "node scripts/npm-build-frontend.mjs",
    "build:backend": "npm --prefix backend run build",
    "build:all": "npm run build:frontend && npm run build:backend",
    "db:migrate": "node scripts/npm-backend-task.mjs db:migrate",
    "setup:owner": "node scripts/npm-backend-task.mjs setup:owner",
    "test:npm-deployment": "node --test tests/npm-deployment.test.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:dashboard": "node --experimental-strip-types --test tests/dashboard-rules.test.mjs",
    "test:items": "node --experimental-strip-types --test tests/item-list-rules.test.mjs",
    "test:item-detail": "node --experimental-strip-types --test tests/item-detail-rules.test.mjs",
    "test:conversion": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:watch": "vitest",
    "test:masters": "node --experimental-strip-types --test tests/master-rules.test.mjs",
    "test:godowns": "node --experimental-strip-types --test tests/godown-rules.test.mjs",
    "test:warehouse-dashboard": "node --experimental-strip-types --test tests/warehouse-dashboard.test.mjs",
    "test:parties": "node --experimental-strip-types --test tests/party-rules.test.mjs",
    "test:sales-orders": "node --experimental-strip-types --test tests/sales-order-rules.test.mjs",
    "test:challans": "node --experimental-strip-types --test tests/challan-rules.test.mjs",
    "test:invoices": "node --experimental-strip-types --test tests/invoice-rules.test.mjs",
    "test:receipts": "node --experimental-strip-types --test tests/receipt-rules.test.mjs",
    "test:purchase-orders": "node --experimental-strip-types --test tests/purchase-order-rules.test.mjs",
    "test:grn": "node --experimental-strip-types --test tests/grn-rules.test.mjs",
    "test:transfers": "node --experimental-strip-types --test tests/transfer-rules.test.mjs",
    "test:adjustments": "node --experimental-strip-types --test tests/adjustment-rules.test.mjs",
    "test:ledger-alerts": "node --experimental-strip-types --test tests/ledger-alert-rules.test.mjs",
    "test:reports": "node --experimental-strip-types --test tests/report-rules.test.mjs",
    "verify:production-env": "node scripts/production-preflight.mjs .env",
    "smoke:gateway": "node scripts/http-smoke.mjs",
    "test:release-security": "node --experimental-strip-types --test tests/release-security.test.mjs",
    "audit:deployment": "node scripts/package-audit.mjs",
    "smoke:authenticated": "node scripts/authenticated-smoke.mjs",
    "smoke:tenant": "node scripts/tenant-isolation-smoke.mjs",
    "smoke:workflow": "node scripts/workflow-acceptance-smoke.mjs",
    "smoke:mysql-rollback": "node scripts/mysql-rollback-smoke.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "typecheck:frontend": "tsc --noEmit -p tsconfig.json",
    "ci:frontend": "npm run test:conversion && npm run build:vercel",
    "ci:backend": "npm --prefix backend run typecheck"
  },
  "overrides": {
    "rolldown": "1.2.1"
