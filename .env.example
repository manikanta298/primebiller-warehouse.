# Copy as .env before running docker compose up --build.
# Example values below are NOT suitable for production deployment.
MYSQL_ROOT_PASSWORD=replace_with_long_random_root_password
MYSQL_PASSWORD=replace_with_url_safe_random_database_password
JWT_SECRET=replace_with_random_64_hex_characters
SETTINGS_KEY=replace_with_independent_random_64_hex_characters
WEB_PORT=8080
APP_URL=http://localhost:8080

# Local SMTP catcher is available at http://localhost:8025.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Girder <no-reply@local.test>

# Production SMTP example: SMTP_HOST=smtp.example.com, SMTP_PORT=587,
# SMTP_SECURITY=starttls, SMTP_USER=..., SMTP_PASSWORD=..., SMTP_FROM=...;
# run the gateway behind HTTPS, then change APP_URL accordingly.
